#!/usr/bin/env Rscript

args <- commandArgs(trailingOnly = TRUE)
script_arg <- grep("^--file=", commandArgs(), value = TRUE)
script_path <- if (length(script_arg)) {
  sub("^--file=", "", script_arg[[1]])
} else {
  "exec/volregger"
}
repo_root <- normalizePath(file.path(dirname(script_path), ".."), mustWork = FALSE)

status <- tryCatch(
  {
    if (requireNamespace("volregger", quietly = TRUE)) {
      volregger::volregger_cli(args)
    } else if (requireNamespace("pkgload", quietly = TRUE) &&
               file.exists(file.path(repo_root, "DESCRIPTION"))) {
      pkgload::load_all(repo_root, export_all = FALSE, helpers = FALSE, quiet = TRUE)
      volregger_cli(args)
    } else {
      message("volregger: package is not installed and pkgload is unavailable")
      2L
    }
  },
  error = function(e) {
    message("volregger: ", conditionMessage(e))
    2L
  }
)

quit(save = "no", status = as.integer(status))
